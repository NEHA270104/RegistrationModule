# Server Configuration
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# Razorpay Configuration
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# MSG91 Email Configuration
# Get Auth Key from: MSG91 Dashboard > API Keys (https://msg91.com)
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_FROM_EMAIL=noreply@yourdomain.com
MSG91_FROM_NAME=AI for MSME Summit
MSG91_DOMAIN=yourdomain.com

# MSG91 Email Template IDs
# Create templates in MSG91 Email Dashboard with these variables:
# Registration: {{name}}, {{booking_id}}, {{tier}}, {{amount}}, {{event_date}}, {{event_time}}, {{venue}}, {{company_name}}
# Waitlist: {{name}}, {{position}}, {{has_livestream}}, {{company_name}}
# OTP: {{otp}}, {{company_name}}
MSG91_TEMPLATE_REGISTRATION=your-template-id
MSG91_TEMPLATE_WAITLIST=your-template-id
MSG91_TEMPLATE_REMINDER=your-template-id
MSG91_TEMPLATE_OTP=your-template-id

# WhatsApp Business API (Optional)
WHATSAPP_API_URL=https://graph.facebook.com/v17.0
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-access-token

# Admin Configuration
ADMIN_API_KEY=your-secure-admin-api-key

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
