{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FlyerConfiguration",
  "type": "object",
  "properties": {
    "colors": {
      "type": "object",
      "properties": {
        "primary": { "type": "string", "pattern": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$" },
        "secondary": { "type": "string", "pattern": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$" },
        "background": { "type": "string" },
        "text": { "type": "string" }
      },
      "additionalProperties": false
    },
    "textContent": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "badge": { "type": "string" },
        "link": { "type": "string" },
        "footer": { "type": "string" }
      },
      "additionalProperties": true
    },
    "layout": {
      "type": "object",
      "properties": {
        "align": { "type": "string", "enum": ["left", "center", "right"] },
        "padding": { "type": "string" },
        "positions": {
          "type": "object",
          "properties": {
            "title": { "type": "string" },
            "subtitle": { "type": "string" },
            "badge": { "type": "string" },
            "logo": { "type": "string" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "logo_url": { "type": "string", "format": "uri" }
  },
  "required": ["colors", "textContent"],
  "additionalProperties": false
}
