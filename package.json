{
  "name": "ai-msme-summit-registration",
  "version": "1.0.0",
  "description": "AI for MSME Business Summit Registration System",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n \"backend,frontend\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npx serve -l 5173 --no-clipboard -c serve.json",
    "install:all": "cd backend && npm install",
    "build": "cd backend && npm run build",
    "start": "cd backend && npm run start"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "serve": "^14.2.1"
  },
  "keywords": [
    "summit",
    "registration",
    "razorpay",
    "supabase"
  ],
  "author": "BRTNeura",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^17.2.3",
    "razorpay": "^2.9.6"
  }
}
